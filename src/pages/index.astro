---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon';
import { event } from '../data/tournament';
const details = [
  {
    icon: 'calendar',
    label: 'Date',
    value: event.shortDate,
    note: 'Weather permitting',
  },
  {
    icon: 'clock',
    label: 'Time',
    value: event.time,
    note: 'Players meeting at 9:30 · games start at 10:00',
    warning: 'Warning: if you show up after 9:30 am, a mystery punishment awaits.',
  },
  {
    icon: 'pin',
    label: 'Location',
    value: event.location,
  },
  {
    icon: 'ball',
    label: 'Volleyball',
    value: `Grass 4 × 4 · 1 pool · 3 courts`,
  },
  { icon: 'ghost', label: 'Dress code', value: 'Costumes encouraged' },
] as const;
const teams = [
  {
    name: 'Canto Fiends + Two Jump Chumps',
    players: 'Miranda & Sara + Karan & Justin',
  },
  {
    name: 'No u come up with one + San Fran Spooks',
    players: 'Alice & Ash + Chase & Rachel',
  },
  { name: 'idk + Sung Jinwoo', players: 'Jiwan & Allison + Ryan V & Stacy' },
  {
    name: 'Magic Mike Shrooms + We suck @ Fishing',
    players: 'Justine & Ray + Alex & Will',
  },
  {
    name: 'LeBlock + Andre & Bryson',
    players: 'Victor & Jacob + Andre & Bryson',
  },
  {
    name: 'Tyler + Chuds + Jackie & Prajanya',
    players: 'David & Tyler + Jackie & Prajanya',
  },
  {
    name: 'Your Last 2 Braincells + Magicpissers',
    players: 'Achinthya & Lucas + Ajay & Jonathan C',
  },
];
---

<Layout active="info">
  <div class="wrap info-page">
    <header class="event-intro">
      <h1>
        Bump-kin
        <br />
        Set Latte
      </h1>
      <img
        src="/images/halloween-volleyball.png"
        alt="A pumpkin and ghost playing volleyball."
        width="1280"
        height="1280"
        fetchpriority="high"
      />
    </header>
    <section class="info-card" aria-label="Event details">
      <dl class="event-details">
        {details.map((item) => (
          <div class="event-row">
            <dt>
              <Icon name={item.icon} size={21} />
              <span>{item.label}</span>
            </dt>
            <dd>
              <span>{item.value}</span>
              {'note' in item && <small>{item.note}</small>}
              {'warning' in item && <small class="warning-note">{item.warning}</small>}
            </dd>
          </div>
        ))}
      </dl>
    </section>
    <section class="weather-card" aria-labelledby="weather-heading">
      <div class="weather-top">
        <div>
          <h2 id="weather-heading">Saturday forecast</h2>
          <p>Cloudy skies. Cozy layers.</p>
        </div>
        <Icon name="cloud" size={44} />
      </div>
      <div class="weather-reading">
        <strong>
          62<span>°F</span>
        </strong>
        <div>
          <span>Forecast high</span>
          <span>No rain expected</span>
        </div>
      </div>
      <p class="weather-tip">
        Chilly morning, possibly wet grass. Bring layers for the sidelines.
      </p>
      <small>Forecast from the organizer's latest update.</small>
    </section>

    <section class="info-section" aria-labelledby="format-heading">
      <div class="section-heading">
        <Icon name="ball" size={21} />
        <h2 id="format-heading">How the day works</h2>
      </div>
      <ol class="format-steps info-card">
        <li>
          <span class="step-number" aria-hidden="true">
            01
          </span>
          <div>
            <h3>Two duos, one team</h3>
            <p>
              Pair up with another duo. Your team of four stays together all
              day.
            </p>
          </div>
        </li>
        <li>
          <span class="step-number" aria-hidden="true">
            02
          </span>
          <div>
            <h3>Pool play</h3>
            <p>
              All seven teams share a single pool. Each matchup is two games
              to 21, rotating across three courts before the playoff stage.
            </p>
          </div>
        </li>
        <li>
          <span class="step-number" aria-hidden="true">
            03
          </span>
          <div>
            <h3>Playoffs & prizes</h3>
            <p>
              Playoffs are best of three, with games to 21. If needed, the
              tiebreaker third set is to 15. First place in each bracket takes
              home a prize.
            </p>
          </div>
        </li>
      </ol>
      <p class="section-note">
        7 teams planned · 28 players confirmed
      </p>
    </section>

    <section class="info-section" aria-labelledby="packing-heading">
      <div class="section-heading">
        <Icon name="bag" size={21} />
        <h2 id="packing-heading">Pack for the day</h2>
      </div>
      <div class="info-card packing-card">
        <ul class="packing-list">
          {[
            'Costume & layers',
            'Water & snacks',
            'Sunscreen & sunglasses',
            'Chair & picnic blanket',
            'Volleyballs',
            'Canopy, if you have one',
          ].map((item) => (
            <li>
              <Icon name="check" size={16} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="card-footer">
          Let's make a mega canopy! Net owners: the organizer will coordinate
          with you directly.
        </p>
      </div>
    </section>

    <section class="info-section" aria-labelledby="rules-heading">
      <div class="section-heading">
        <Icon name="info" size={21} />
        <h2 id="rules-heading">Court etiquette</h2>
      </div>
      <p>
        Standard outdoor rules. Call your own open hand receives and doubles
        honestly, stay out of neighboring courts, and play safe.
      </p>
      <p class="rules-link">
        <a
          href="https://docs.google.com/document/d/1SNM4GeuPH_XIIaAObCw3xNWCvBsJDszBgqwJXMdS2sE/edit?usp=sharing"
          target="_blank"
          rel="noreferrer"
        >
          Tournament rules document
        </a>
      </p>
      <div class="house-rules">
        <div class="house-rule">
          <span class="rule-label">House rule 01</span>
          <h3>Accidental rollover</h3>
          <p>
            Win a point, then accidentally roll the ball across the net's plane
            to the other team? You lose that point, and they serve.
          </p>
        </div>
        <div class="house-rule">
          <span class="rule-label">House rule 02</span>
          <h3>Jump serve gamble</h3>
          <p>
            Jump serves are welcome. Miss one into the net or out of bounds, and
            your team gets <strong>−1 point.</strong>
          </p>
        </div>
      </div>
    </section>

    <section class="info-section" aria-labelledby="prizes-heading">
      <div class="section-heading">
        <Icon name="trophy" size={21} />
        <h2 id="prizes-heading">Up for grabs</h2>
      </div>
      <div class="info-card prize-list">
        <div>
          <span class="prize-icon">
            <Icon name="trophy" size={22} />
          </span>
          <div>
            <h3>Bracket champions</h3>
            <p>First place in both the upper & lower brackets.</p>
          </div>
        </div>
        <div>
          <span class="prize-icon">
            <Icon name="ghost" size={22} />
          </span>
          <div>
            <h3>Best costume</h3>
            <p>
              Individual or duo, decided by vote. Group costumes encouraged!
            </p>
          </div>
        </div>
        <div>
          <span class="prize-icon">
            <Icon name="sparkles" size={22} />
          </span>
          <div>
            <h3>Two mystery awards</h3>
            <p>
              Individual / duo votes. Categories revealed on tournament day.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="info-section" aria-labelledby="duos-heading">
      <div class="section-heading">
        <Icon name="ghost" size={21} />
        <h2 id="duos-heading">The team lineup</h2>
        <span class="section-count">7 confirmed</span>
      </div>
      <ol class="duo-list info-card">
        {teams.map((team, index) => (
          <li>
            <span class="duo-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{team.name}</h3>
              <p>{team.players}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>
