---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import scheduleIllustration from '../assets/schedule.png';
import DemoNotice from '../components/DemoNotice.astro';
import Schedule from '../components/Schedule';
import { getTournamentData } from '../data/tournament';
const data = await getTournamentData();
---

<Layout title="Schedule" active="schedule">
  <div class="wrap interior-page">
    <header class="page-heading">
      <h1>Schedule</h1>
      <Image
        src={scheduleIllustration}
        alt=""
        width={134}
        height={134}
        widths={[134, 268, 402]}
        sizes="(min-width: 600px) 134px, 112px"
        loading="eager"
      />
    </header>
    <DemoNotice />
    <Schedule {...data} client:load />
    <noscript>
      <p class="noscript-notice">
        Enable JavaScript to search teams, filter matches, and view playoff
        details. The sample matches are listed above.
      </p>
    </noscript>
  </div>
</Layout>
